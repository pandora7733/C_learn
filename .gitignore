# =========================================================================
# Arch Linux + KDE + VS Code + C 언어 환경 .gitignore
# =========================================================================

# 1. 리눅스 C 언어 컴파일 결과물
# -------------------------------------------------------------------------
*.o
*.obj
*.out
*.a
*.so

# 확장자가 없는 리눅스 실행 파일들을 배제하기 위해, 
# 보통 c 공부 시 'build' 나 'out' 폴더를 만들어 그 안에 실행파일을 모으고 폴더 통째로 제외하는 것이 편리합니다.
/build/
/out/
/bin/

# 2. VS Code 관련 설정
# -------------------------------------------------------------------------
.vscode/

# 3. 아치 리눅스 및 KDE 환경 파일
# -------------------------------------------------------------------------
# KDE 파일 관리자(Dolphin) 등에서 생성하는 메타데이터 및 캐시
.directory
*.kdev4

# 리눅스 시스템 공통 무시 파일
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# 4. 컴파일러/에러 로그
# -------------------------------------------------------------------------
*.log